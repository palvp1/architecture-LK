<mxCell id="c29" value="Clarification belongs to the call&#10;The outer application speaks the prompt, keeps the pending benefit request and resumes the active skill." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="870" y="260" width="320" height="110" as="geometry" /></mxCell>
<mxCell id="c30" value="State isolation&#10;Call ID maps to skill/workflow ID and backend session. Distinct caller sessions never share bot state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="870" y="480" width="320" height="110" as="geometry" /></mxCell>
<mxCell id="c31" value="Retain result provenance and permitted context. A coverage/eligibility decision requires an authoritative rule or service; the language model must not infer it." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="1300" height="30" as="geometry" /></mxCell>
