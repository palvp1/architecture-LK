<mxCell id="c27" value="Cold SIP REFER is a separate transfer option: once successful, the caller leaves the LiveKit session. It does not preserve the same in-room media or guarantee a desktop screen-pop." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="1200" height="40" as="geometry" /></mxCell>
