<diagram name="05 - Exceptions and handoff" id="page5"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="Keep control when the normal path breaks" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry" /></mxCell>
<mxCell id="c2" value="A call remains interactive while tasks execute. Interrupting speech and cancelling business work are separate decisions." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1100" height="20" as="geometry" /></mxCell>
<mxCell id="g3" value="VOICE EVENTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="380" height="500" as="geometry" /></mxCell>
<mxCell id="c4" value="Listening / speaking&#10;AgentSession turn handling is active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="340" height="80" as="geometry" /></mxCell>
<mxCell id="c5" value="Speech or DTMF arrives&#10;VAD/interruption policy stops eligible playback; SIP DTMF becomes structured input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="c6" value="Reconcile pending work&#10;New turn generation; retain valid state; cancel obsolete work; discard stale replies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="c7" value="Resume conversation&#10;No late answer may overwrite the new turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="340" height="80" as="geometry" /></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4d4d4d;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4d4d4d;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4d4d4d;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="g11" value="SKILL / PROVIDER FAILURE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="380" height="500" as="geometry" /></mxCell>
<mxCell id="c12" value="Task deadline or error&#10;Timeout, malformed output, auth or quota failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="340" height="80" as="geometry" /></mxCell>
<mxCell id="c13" value="Classify before retry&#10;Retry only transient failures within budget; writes need idempotency; never replay unknown commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="c14" value="Bounded recovery&#10;Use approved equivalent route or explain the delay; offer follow-up or human assistance for long work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="c15" value="Resolved or escalate&#10;Track cancellation outcome and suppress late output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="480" y="470" width="340" height="80" as="geometry" /></mxCell>
<mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4d4d4d;endArrow=block;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4d4d4d;endArrow=block;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4d4d4d;endArrow=block;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="g19" value="HUMAN ESCALATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="380" height="500" as="geometry" /></mxCell>
<mxCell id="c20" value="Caller requests / policy triggers&#10;Reason + permitted context package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="340" height="80" as="geometry" /></mxCell>
<mxCell id="c21" value="Prepare and route handoff&#10;Queue/desktop API receives summary, verified identity, completed results, unresolved tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="c22" value="Connect the human&#10;Desktop joins LiveKit room, or supported warm SIP transfer with context via separate API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="360" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="c23" value="Confirm connected&#10;Stop automated speech on acceptance; on failure keep caller and offer another path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="340" height="80" as="geometry" /></mxCell>
<mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4d4d4d;endArrow=block;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#4d4d4d;endArrow=block;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry" /></mxCell>
