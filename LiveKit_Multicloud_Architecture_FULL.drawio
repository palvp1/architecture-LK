<diagram name="02 - Voice and protocol boundaries" id="page2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="Where each protocol begins and ends" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry" /></mxCell>
<mxCell id="c2" value="Baseline voice pipeline: speech recognition, application routing and tools, then speech synthesis. CX / Lex receive text and data." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1100" height="20" as="geometry" /></mxCell>
